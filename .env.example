# Copy to `.env` and adjust for your local Splunk/Codex setup.

# Splunk MCP connection
SPLUNK_MCP_URL=https://127.0.0.1:8089/services/mcp
SPLUNK_MCP_AUTH_HEADER=Bearer <token>
SPLUNK_MCP_VERIFY_TLS=false

# Codex / AI fallback behavior
CODEX_MCP_DIRECT=false
CODEX_MCP_AGENT=false
SPLUNK_AI_ASSISTANT_ENABLED=false
CODEX_RCA_MODEL=

# Optional FastAPI auth
AGENTIC_OPS_API_TOKEN=

# Splunk HEC writeback
SPLUNK_HEC_URL=https://127.0.0.1:8088/services/collector
SPLUNK_HEC_TOKEN=<hec-token>
SPLUNK_HEC_AI_TRIAGE_INDEX=ai_triages
SPLUNK_HEC_VERIFY_TLS=false
